FROM dunglas/frankenphp

ARG USER=1000
RUN apt-get update && apt-get install -y \
    procps \
    ffmpeg \
    gcc \
    libc6-dev

# PHP extensions
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
RUN install-php-extensions intl redis pcntl sockets gd

# Compile C utilities and cleanup immediately
COPY ext/*.c /tmp/
RUN gcc -O2 -o /usr/local/bin/set_fifo_size /tmp/set_fifo_size.c \
    && gcc -O2 -o /usr/local/bin/get_fifo_bytes_available /tmp/get_fifo_bytes_available.c \
    && rm -rf /tmp/*.c

# Setup application directory and user
WORKDIR /app
RUN useradd -u ${USER} -m appuser || true \
    && mkdir -p /buffers /config/caddy /data/caddy \
    && chown -R appuser:appuser /app /buffers /config/caddy /data/caddy \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp

# Copy code as the created user to avoid permission issues
COPY --chown=appuser:appuser . .

USER appuser

# Install dependencies
RUN composer install --no-dev --optimize-autoloader \
    && npm install \
    && npm run build
