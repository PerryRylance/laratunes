FROM dunglas/frankenphp

USER root

# Dependencies
RUN apt-get update && apt-get install -y \
    procps \
	ffmpeg

# PHP extensions
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" || true

RUN install-php-extensions intl redis pcntl sockets gd

# Laratunes FIFO buffers
COPY ext/set_fifo_size.c /tmp/set_fifo_size.c
RUN gcc -O2 -o /usr/local/bin/set_fifo_size /tmp/set_fifo_size.c

COPY ext/get_fifo_bytes_available.c /tmp/get_fifo_bytes_available.c
RUN gcc -O2 -o /usr/local/bin/get_fifo_bytes_available /tmp/get_fifo_bytes_available.c

RUN mkdir -p /buffers && chmod 777 /buffers

# Configure FrankenPHP
RUN useradd -m ${USER} || true

ARG USER=1000

RUN \
	# Use "adduser -D ${USER}" for alpine based distros
	useradd ${USER}; \
	# Add additional capability to bind to port 80 and 443
	setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp; \
	# Give write access to /config/caddy and /data/caddy
	chown -R ${USER}:${USER} /config/caddy /data/caddy

# Build
RUN \
	# Install Composer packages
	cd /app/public \
	composer install --no-dev --optimize-autoloader \
	# Install NPM packages and build
	npm install \
	npm run build

# Patch QR code generator, stops deprecation notice crashing the server
RUN find vendor/chillerlan/php-qrcode -name "*.php" -exec sed -i 's/.*imagedestroy.*/\/\/ &/' {} +
