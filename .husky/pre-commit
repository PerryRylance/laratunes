STAGED_FILES=$(git diff --name-only --cached --diff-filter=AM | grep '.php$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Run your custom Stout formatting script via Sail
./vendor/bin/sail up -d
./vendor/bin/sail composer run format -- $STAGED_FILES

# Re-add the files to the commit if Stout modified them
git add $STAGED_FILES
